# ============================================
# CONFIGURATION ENVIRONNEMENT BACKEND
# ============================================

# Mode développement ou production
DEBUG=True

# Configuration Base de Données
# Utiliser SQLite en développement, PostgreSQL en production
USE_SQLITE=True
# USE_SQLITE=False  # Pour PostgreSQL

# PostgreSQL (utilisé si USE_SQLITE=False)
DB_NAME=OPTINET_db
DB_USER=star_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ============================================
# CONFIGURATION EN PRODUCTION
# ============================================
# ALLOWED_HOSTS=optinetbackend.ginolux.com,www.optinetbackend.ginolux.com
# CSRF_TRUSTED_ORIGINS=https://optinetbackend.ginolux.com,https://www.optinetbackend.ginolux.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
